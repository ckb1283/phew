{
  "name": "phew",
  "version": "0.0.1",
  "private": true,
  "description": "Phew — tailored med-kit shopping lists (phewbag.com)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "vite",
    "test": "tsx --test tests/engine.test.ts",
    "fixture": "tsx scripts/fixture.ts",
    "build": "tsc && vite build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": "22.x"
  }
}
